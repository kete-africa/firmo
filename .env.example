# Firmo reads its configuration from the environment. Never commit real values.

# The application role (no BYPASSRLS) of the Neon branch this instance serves.
FIRMO_DATABASE_URL="postgresql://firmo_app:...@host/firmo?sslmode=require"
# development | preview | staging | production
KETE_ENVIRONMENT="development"

# Local development and tests: the Neon branches (owner for migrations, app for the server).
FIRMO_TEST_OWNER_URL=""
FIRMO_TEST_APP_URL=""
FIRMO_DEV_OWNER_URL=""
FIRMO_DEV_APP_URL=""

# Reads @kete-africa/* from GitHub Packages (a classic token with read:packages only).
KETE_PACKAGES_TOKEN=""

# Firmo's public origin, and the Compte Kete it signs people in with (doctrine D-024).
FIRMO_URL="http://localhost:3400"
KETE_ACCOUNT_URL="http://localhost:3100"
# Firmo's registration at the Compte Kete: clients create --people (kete-core spec 013).
FIRMO_CLIENT_ID=""
FIRMO_CLIENT_SECRET=""
# At least 32 random characters, Firmo's only: signs its session cookie.
FIRMO_SESSION_SECRET=""
# Neon Object Storage of the branch this instance serves (issued PDFs, logos).
FIRMO_STORAGE_ENDPOINT=""
FIRMO_STORAGE_REGION=""
FIRMO_STORAGE_BUCKET="files"
FIRMO_STORAGE_ACCESS_KEY_ID=""
FIRMO_STORAGE_SECRET_ACCESS_KEY=""

# The model (conversation port). Tests use a scripted model; pnpm eval:conversation the real one.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"
OPENAI_REASONING_EFFORT="medium"
OPENAI_TRANSCRIPTION_MODEL="gpt-4o-transcribe"
# WhatsApp (Meta Cloud API): the channel opens only when all four are set.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_GRAPH_VERSION="v25.0"
# Telegram (Bot API): the channel opens when both are set.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
# The inbox worker runs in the web process; "off" for an instance that only serves pages.
FIRMO_WORKER="on"

# Where people create documents, shown in the web space.
FIRMO_WHATSAPP_NUMBER=""
FIRMO_TELEGRAM_BOT=""
# The document template bundle's folder (the image sets /app/document); defaults to ./document.
FIRMO_DOCUMENT_ROOT=""
# Test object storage (Neon, test branch) for integration and e2e runs.
FIRMO_TEST_STORAGE_ENDPOINT=""
FIRMO_TEST_STORAGE_REGION=""
FIRMO_TEST_STORAGE_BUCKET="files"
FIRMO_TEST_STORAGE_ACCESS_KEY_ID=""
FIRMO_TEST_STORAGE_SECRET_ACCESS_KEY=""
