# Firmo reads its configuration from the environment. Never commit real values.

# The application role (no BYPASSRLS) of the Neon branch this instance serves.
FIRMO_DATABASE_URL="postgresql://firmo_app:...@host/firmo?sslmode=require"
# development | preview | staging | production
KETE_ENVIRONMENT="development"

# Local development and tests: the Neon branches (owner for migrations, app for the server).
FIRMO_TEST_OWNER_URL=""
FIRMO_TEST_APP_URL=""
FIRMO_DEV_OWNER_URL=""
FIRMO_DEV_APP_URL=""

# Reads @kete-africa/* from GitHub Packages (a classic token with read:packages only).
KETE_PACKAGES_TOKEN=""

# Firmo's public origin, and the Compte Kete it signs people in with (doctrine D-024).
FIRMO_URL="http://localhost:3400"
KETE_ACCOUNT_URL="http://localhost:3100"
# Firmo's registration at the Compte Kete: clients create --people (kete-core spec 013).
FIRMO_CLIENT_ID=""
FIRMO_CLIENT_SECRET=""
# At least 32 random characters, Firmo's only: signs its session cookie.
FIRMO_SESSION_SECRET=""
# Neon Object Storage of the branch this instance serves (issued PDFs, logos).
FIRMO_STORAGE_ENDPOINT=""
FIRMO_STORAGE_REGION=""
FIRMO_STORAGE_BUCKET="files"
FIRMO_STORAGE_ACCESS_KEY_ID=""
FIRMO_STORAGE_SECRET_ACCESS_KEY=""
