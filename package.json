{
  "name": "firmo",
  "private": true,
  "type": "module",
  "description": "Firmo, by Kete: quotes, proformas and invoices from a voice note, a photo or a text.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev --port 3400",
    "build": "vite build",
    "start": "srvx serve --entry dist/server/server.js --static dist/client --prod --host 0.0.0.0 --port 3000",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm i18n:check",
    "lint": "eslint .",
    "typecheck": "vite build && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "tsx tooling/scripts/check-hardcoded-strings.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "channels:show": "tsx scripts/channels.ts show",
    "channels:point": "tsx scripts/channels.ts point",
    "cockpit:connect": "tsx scripts/cockpit.ts connect",
    "cockpit:status": "tsx scripts/cockpit.ts status",
    "eval:conversation": "tsx --tsconfig tsconfig.json scripts/eval-conversation.ts"
  },
  "dependencies": {
    "@kete/auth": "npm:@kete-africa/auth@^0.3.0",
    "@kete/design": "npm:@kete-africa/design@^0.6.0",
    "@kete/feedback": "npm:@kete-africa/feedback@^0.1.1",
    "@kete/files": "npm:@kete-africa/files@^0.4.0",
    "@kete/sdk": "npm:@kete-africa/sdk@^0.6.0",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-start": "^1.168.59",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.3",
    "openai": "^6.49.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "srvx": "0.11.22",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@inlang/paraglide-js": "^2.25.4",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "jose": "^6.2.12",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
